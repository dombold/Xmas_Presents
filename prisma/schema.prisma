generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A paying unit: a sibling on their own, or a sibling and partner.
/// Presents are paid for by households and costs are shared between them.
model Household {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  members   Person[]
  gifts     Gift[]
  paysOut   Settlement[] @relation("SettlementFrom")
  paidIn    Settlement[] @relation("SettlementTo")
}

/// Anyone who can receive a present. People in a household (adults and kids)
/// are paid for by the *other* households; people with no household
/// (e.g. grandparents) are shared by every household.
model Person {
  id             String          @id @default(cuid())
  name           String          @unique
  householdId    String?
  household      Household?      @relation(fields: [householdId], references: [id], onDelete: Restrict)
  /// Adults who can sign in and enter presents.
  canLogin       Boolean         @default(false)
  /// Personal PIN (scrypt). Null until the person first signs in with the family PIN and sets one.
  pinHash        String?
  /// Bumped when the PIN changes or is reset; signs out every existing session for this person.
  sessionVersion Int             @default(0)
  /// Can edit or delete any present they can see. Set from data/family.json "admins".
  isAdmin        Boolean         @default(false)
  /// No longer bought for (data/family.json "pastShared"): kept so past years still add up,
  /// but left out of this year's lists and the add-a-present form.
  retired        Boolean         @default(false)
  sortOrder      Int             @default(0)
  received       GiftRecipient[]
  giftsEntered   Gift[]          @relation("EnteredBy")
  settlements    Settlement[]

  @@index([householdId])
}

model Gift {
  id          String          @id @default(cuid())
  year        Int
  /// Null: bought by the person who entered it (a shared recipient who can sign in) with their own
  /// money. Listed so nobody doubles up, but never split and not counted as anyone being covered.
  buyerId     String?
  buyer       Household?      @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  description String
  /// Whole cents to avoid floating point drift.
  costCents   Int
  note        String?
  enteredById String?
  enteredBy   Person?         @relation("EnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)
  recipients  GiftRecipient[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([year])
  @@index([buyerId])
}

/// A present can be for one person or shared by several (e.g. a joint gift to a couple);
/// its cost is divided equally between its recipients.
model GiftRecipient {
  giftId   String
  gift     Gift   @relation(fields: [giftId], references: [id], onDelete: Cascade)
  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@id([giftId, personId])
  @@index([personId])
}

/// A "Settle up" payment the payee has ticked as received. Payments are worked out from the
/// presents, so a tick only counts while the amount still matches (adding or changing a
/// present for that year clears it).
model Settlement {
  year            Int
  fromHouseholdId String
  from            Household @relation("SettlementFrom", fields: [fromHouseholdId], references: [id], onDelete: Cascade)
  toHouseholdId   String
  to              Household @relation("SettlementTo", fields: [toHouseholdId], references: [id], onDelete: Cascade)
  amountCents     Int
  /// Who ticked it (null when marked by a script).
  settledById     String?
  settledBy       Person?   @relation(fields: [settledById], references: [id], onDelete: SetNull)
  settledAt       DateTime  @default(now())

  @@id([year, fromHouseholdId, toHouseholdId])
}
